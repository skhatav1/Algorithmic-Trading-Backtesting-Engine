{
  "buildCommand": null,
  "outputDirectory": "public",
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,**/__pycache__/**,**/*.pyc,backtester.egg-info/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/backtest",
      "destination": "/api/backtest.py"
    }
  ]
}
